<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own launch screen; make it the same ink as the app so there is no white flash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/launch_ink</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
